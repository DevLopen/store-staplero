{
  "name": "Staplero Postfach: KI-Entwurf",
  "nodes": [
    {
      "id": "52ece3cd-f22a-4dd3-ba55-935cb60e73a0",
      "name": "Webhook vom Panel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "f414f028-72cb-456f-8f6c-8b41b6c7a0ee",
      "parameters": {
        "httpMethod": "POST",
        "path": "staplero-inbox-draft",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Staplero Inbox Secret"
        }
      }
    },
    {
      "id": "17e57f17-4032-4b4c-9b84-9301d5c91f41",
      "name": "Konfiguration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0924fecf-cfda-4da9-b6ea-c374ee8efbc0",
              "name": "backendUrl",
              "value": "https://staplero.de/api",
              "type": "string"
            },
            {
              "id": "21e19534-30e9-49fe-b99d-48dc89ad8404",
              "name": "threadId",
              "value": "={{ $json.body.threadId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7ab702e9-e1f2-45a1-8bcf-237852be82e9",
      "name": "Verlauf laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $json.backendUrl }}/inbox/hook/threads/{{ $json.threadId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Staplero Inbox Secret"
        }
      }
    },
    {
      "id": "01900182-bb6e-4490-92bb-98f544f65c88",
      "name": "Prompt bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Prompt baut das Backend (backend/src/services/inboxPrompt.ts), hier nur weiterreichen\nreturn [{ json: { threadId: $json.threadId, openaiBody: $json.openaiBody } }];"
      }
    },
    {
      "id": "b55fef0d-4fde-4d89-b39b-4f8916150b8c",
      "name": "OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.openaiBody) }}",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI Staplero"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "id": "b8dffcaa-f5a5-4f9d-9a55-b3bfbf9260c5",
      "name": "Antwort lesen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -80
      ],
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet r;\ntry { r = JSON.parse(raw); } catch (e) { r = { error: 'KI-Antwort war kein JSON' }; }\n// Panel erwartet `summary`\nif (r.summary_de !== undefined) { r.summary = r.summary_de; delete r.summary_de; }\n// Gedankenstriche sicherheitshalber entfernen\nif (r.draft) r.draft = r.draft.replace(/\\s[–—]\\s/g, ', ').replace(/[–—]/g, '-');\nreturn [{ json: { threadId: $('Verlauf laden').first().json.threadId, result: r } }];"
      }
    },
    {
      "id": "d20fc686-b083-499e-84b2-a7b9712f906e",
      "name": "Entwurf ins Panel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Konfiguration').first().json.backendUrl }}/inbox/hook/threads/{{ $json.threadId }}/ai",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.result) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Staplero Inbox Secret"
        }
      }
    },
    {
      "id": "b58dbfdc-08b8-4843-b317-fed9cc116662",
      "name": "Fehler ins Panel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Konfiguration').first().json.backendUrl }}/inbox/hook/threads/{{ $('Konfiguration').first().json.threadId }}/ai",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ error: 'OpenAI: ' + ($json.error?.message || 'keine Antwort') }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Staplero Inbox Secret"
        }
      }
    }
  ],
  "connections": {
